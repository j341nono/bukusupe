{
  "name": "bukusupe",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome のブックマークを意味で並べた宇宙地図として見る拡張機能",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode web",
    "prebuild:web": "node scripts/copy-ort.mjs",
    "sample:precompute": "npm run build && node scripts/precompute-sample.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "check:ext": "node scripts/check-dist.mjs; d=$?; node scripts/check-fresh.mjs; c=$?; node scripts/check-extension.mjs; e=$?; node scripts/check-flight.mjs; f=$?; node scripts/check-idle.mjs; i=$?; npm run build:web >/dev/null && node scripts/check-web.mjs; w=$?; exit $((d | c | e | f | i | w))",
    "prebuild": "node scripts/copy-ort.mjs",
    "predev": "node scripts/copy-ort.mjs",
    "check:flight": "node scripts/check-flight.mjs",
    "check:web": "npm run build:web && node scripts/check-web.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "bench": "node scripts/bench/index.mjs",
    "bench:report": "node scripts/bench/report.mjs",
    "check:idle": "node scripts/check-idle.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.28",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
