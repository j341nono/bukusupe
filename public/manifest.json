{
  "manifest_version": 3,
  "name": "ブクスペ",
  "short_name": "ブクスペ",
  "version": "0.1.0",
  "description": "ブックマークを星として、意味の近さで並べた宇宙地図。検索で星を引き寄せ、選んだ星を星座にする。",
  "minimum_chrome_version": "114",
  "permissions": [
    "bookmarks",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ブクスペを開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "https://*.huggingface.co/*",
    "https://*.xethub.hf.co/*"
  ]
}
